# Server-only admin settings. Keep real values in an ignored .env.local file.
# Salt: 16+ random bytes encoded as hex. Hash: scrypt(password, salt, 64),
# using the hexadecimal salt text as the scrypt salt, encoded as 128 hex chars.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
# Independent random session secret with at least 32 characters.
ADMIN_SESSION_SECRET=
# Opt in only on this private development machine. Never loads in production.
ADMIN_LOCAL_INVENTORY=0
# Login throttling is in-memory per server process. Distributed deployments
# require an external persistent limiter before broader administrative use.
